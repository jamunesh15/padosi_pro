PORT=4000

# Local Postgres from docker compose (host port 5433). Neon in production.
DATABASE_URL=postgres://padosipro:padosipro@localhost:5433/padosipro

# Any random strings of 32+ characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-string-for-jwt
JWT_EXPIRES_IN=7d
OTP_SECRET=replace-with-a-different-long-random-string

# Mailpit from docker compose; inbox at http://localhost:8025.
# For Gmail: smtp.gmail.com, 465, SMTP_SECURE=true, your Gmail address and an app password, MAIL_FROM with the same address.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PadosiPro <no-reply@padosipro.local>"

# Comma-separated origins for the web preview, or * for any
CORS_ORIGINS=*
