# Base URL of the backend, without /api. Read at build time, so restart Expo after changing it.
#   Phone on the same Wi-Fi (Expo Go): http://<your-computer-LAN-IP>:4000
#   Android emulator:                  http://10.0.2.2:4000
#   Hosted backend (used for the APK): https://<your-backend>.vercel.app
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
