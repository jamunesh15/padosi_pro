# Optional. Without this file, docker compose sends every email to Mailpit (http://localhost:8025).
# Copy to .env to send real OTP emails through Gmail with Nodemailer.
# SMTP_PASS is a Gmail app password (Google Account → Security → 2-Step Verification → App passwords), not your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your16charapppassword
MAIL_FROM="PadosiPro <you@gmail.com>"
